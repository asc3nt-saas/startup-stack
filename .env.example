# Leave these empty to run in demo mode (no login, data stays in the browser).
# Find both values in Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the AI roadmap (https://aistudio.google.com/apikey).
# Never prefix it with NEXT_PUBLIC_. Without it, uploads return a sample roadmap.
GEMINI_API_KEY=
# Optional: a different Gemini model.
# GEMINI_MODEL=gemini-3.8-flash
